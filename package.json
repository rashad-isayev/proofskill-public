{
  "name": "proofskill",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test --config playwright.hiring.config.ts",
    "auth:migrate": "node --env-file=.env.local --import tsx scripts/migrate-auth.ts",
    "account:migrate": "node --env-file=.env.local --import tsx scripts/migrate-account.ts",
    "test:unit": "node --import tsx --test tests/unit/*.unit.ts",
    "test:b2b": "playwright test --config playwright.b2b.config.ts",
    "preview:frontend": "node --import tsx tests/b2b/harness/preview.mts",
    "hiring:migrate": "node --env-file=.env.local --import tsx scripts/migrate-hiring.ts",
    "test:hiring:database": "node --env-file=.env.local --conditions=react-server --import tsx --test tests/hiring/*.test.ts",
    "test:hiring:browser": "playwright test --config playwright.hiring.config.ts",
    "test:request-limits": "node --import tsx --test tests/security/request-limits.test.ts"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.4.0",
    "@radix-ui/react-tabs": "1.1.22",
    "@xyflow/react": "12.12.0",
    "better-auth": "1.7.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "exceljs": "4.4.0",
    "jszip": "3.10.2",
    "lucide-react": "1.54.0",
    "next": "16.4.3",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}

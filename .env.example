# Server-only settings. Do not expose these with NEXT_PUBLIC_ prefixes.
# Provider configuration is used only by server-side adaptive hiring functions.
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional, for an OpenAI-compatible provider:
OPENAI_BASE_URL=

# Dedicated local PostgreSQL database; application storage may use APP_DATABASE_URL.
AUTH_DATABASE_URL=
# Generate a random value of at least 32 characters; never commit the actual secret.
BETTER_AUTH_SECRET=
# Exact app origin, e.g. http://localhost:3000 locally and HTTPS in production.
BETTER_AUTH_URL=
# Local Docker database password. Not needed for the read-only frontend preview.
PROOFSKILL_AUTH_DB_PASSWORD=

# Optional application database. Defaults to AUTH_DATABASE_URL if omitted.
# Run account:migrate and hiring:migrate to initialize application storage.
APP_DATABASE_URL=

# Assessment monitoring is controlled by published policies; no global bypass flag.

# Private LOCAL development recording only. Disabled until retention is explicitly agreed.
RECORDING_ENABLED=false
RECORDING_RETENTION_DAYS=
# Absolute private path outside public/. Never configure this adapter on Vercel.
RECORDING_LOCAL_DIRECTORY=
